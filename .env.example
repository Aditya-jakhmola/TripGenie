# =============================================================
# TripGenie - example environment file
#
# Copy this file to ".env" and fill in your own values:
#     cp .env.example .env
#
# Never commit your real .env. Only this example file is tracked.
# =============================================================


# ---- LLM (required) ----
# Free key: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b


# ---- Data sources ----
# Hotel and attraction search (required). https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key

# Weather and forecast (required). https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key

# Airport and airline data (recommended). https://aviationstack.com/
# If left empty, the flights section reports it is unavailable and the
# rest of the plan still completes.
AVIATIONSTACK_API_KEY=


# ---- Database (required) ----
# PostgreSQL stores LangGraph checkpoints, trip history and user accounts.
# Use the EXTERNAL connection URL from your provider (for example Render).
# Format:
#   postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://user:password@host:5432/dbname


# ---- Authentication (required) ----
# Signs login tokens. Use a long random string and keep it stable:
# changing it logs every user out. Generate one with:
#     python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=replace_with_a_long_random_string

# Optional auth tuning
# AUTH_COOKIE=tripgenie_auth
# AUTH_SESSION_TTL_SECONDS=2592000
# PASSWORD_HASH_ITERATIONS=260000


# ---- Geocoding (optional) ----
# OpenStreetMap's usage policy requires an identifying User-Agent.
# Put your own app name and contact email here.
GEOCODE_USER_AGENT=TripGenie/1.0 (your-email@example.com)


# ---- Redis cache (optional) ----
# Leave REDIS_URL unset to run without a cache. The app works fine,
# it just repeats external calls instead of reusing results.
# REDIS_URL=redis://localhost:6379/0
# CACHE_ENABLED=true
# CACHE_KEY_PREFIX=tripgenie
# CACHE_RECONNECT_SECONDS=60

# Optional cache lifetimes, in seconds
# CACHE_TTL_AIRPORTS=604800
# CACHE_TTL_HOTELS=21600
# CACHE_TTL_FORECAST=3600
# CACHE_TTL_WEATHER=600
# CACHE_TTL_DESTINATION=86400
# CACHE_TTL_GEOCODE=2592000


# ---- Prompt size limits (optional) ----
# Lower these if you hit Groq free-tier token limits.
# AIRPORT_DATA_CHAR_LIMIT=3000
# AIRLINE_DATA_CHAR_LIMIT=3000
# TAVILY_RESULT_CHAR_LIMIT=2000


# ---- Server (optional) ----
HOST=127.0.0.1
PORT=8000
RELOAD=true
LOG_LEVEL=INFO

# Only needed if the browser talks to the API from a different origin
# (not required for local use):
# CORS_ORIGINS=https://your-frontend.example.com
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=false
